# Server-side only. These are read with process.env inside server functions and
# are never exposed to the browser, so they must NOT use the VITE_ prefix.

# Aptos Build API key used for both fullnode and indexer requests (optional,
# but strongly recommended in production to avoid public rate limits).
APTOS_BUILD_API_KEY=

# Endpoint overrides. Both default to hosted mainnet when unset; the e2e suite
# points them at a local mock server.
APTOS_FULLNODE_URL=
APTOS_INDEXER_URL=https://api.mainnet.aptoslabs.com/v1/graphql
