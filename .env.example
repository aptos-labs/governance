# Backend key — server-side only. Read with process.env inside server
# functions and never inlined into the browser bundle.
#
# Create a Geomi *server* key at https://geomi.dev (starts with
# aptoslabs_). Set it on Vercel as APTOS_BUILD_API_KEY.
# Do not use VITE_APTOS_BUILD_API_KEY — that name is ignored and would
# inline the server secret into the public bundle.
#
# After deploy, serverless logs should show:
#   [aptos] Using backend server API key from APTOS_BUILD_API_KEY
APTOS_BUILD_API_KEY=

# Frontend key — inlined into the public client bundle (VITE_ prefix).
# Create a Geomi *client* key (starts with AG-) with this site's origin
# allowlisted. Used by the wallet adapter and browser Aptos SDK calls.
#
# Also accepted: VITE_APTOS_API_KEY_MAINNET, VITE_GEOMI_API_KEY
VITE_APTOS_API_KEY=

# Endpoint overrides. Both default to hosted mainnet when unset; the e2e suite
# points them at a local mock server. Geomi keys authenticate against these
# Aptos Labs URLs — you do not need a geomi.dev host.
APTOS_FULLNODE_URL=
APTOS_INDEXER_URL=https://api.mainnet.aptoslabs.com/v1/graphql

# --- Governance alerts to Aptos Labs Slack #governance
#
# Run a persistent worker (recommended; no Upstash):
#   pnpm notifications:worker
# Optional HTTP trigger if you also run the web app on a machine with disk:
#   GET /api/cron/notifications  (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=
#
# Public origin used in alert links.
NOTIFICATIONS_PUBLIC_APP_URL=https://governance.aptosfoundation.org
#
# Snapshot JSON written by the worker so restarts do not re-notify.
NOTIFICATIONS_STORE_PATH=.data/notifications.json
NOTIFICATIONS_POLL_INTERVAL_MS=300000
#
# Post to Aptos Labs Slack #governance. Prefer an Incoming Webhook created
# in that channel. A bot token is an alternative (invite the bot to
# #governance; the app always posts to that channel name).
NOTIFICATIONS_SLACK_WEBHOOK_URL=
NOTIFICATIONS_SLACK_BOT_TOKEN=
